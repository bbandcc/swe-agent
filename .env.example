AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-flash
AGENT_MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# S3.1 library config; the non-durable langgraph dev graph does not enforce
# these model/run budgets yet.
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
# For Anthropic instead: set AGENT_MODEL_PROVIDER=anthropic, AGENT_MODEL,
# and ANTHROPIC_API_KEY; leave AGENT_MODEL_BASE_URL empty.
SWE_AGENT_WORKSPACE=./workspace_repo
SWE_AGENT_RUNTIME_ROOT=./.swe-agent-runtime
SWE_AGENT_RUN_TIMEOUT_SECONDS=1800
SWE_AGENT_MAX_STEPS=100
SWE_AGENT_MAX_COST_USD=
# Optional pricing snapshot; set all three values together or leave all empty.
AGENT_MODEL_INPUT_COST_PER_MILLION_USD=
AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=
AGENT_MODEL_PRICING_SOURCE=
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
# Optional JSON list of trusted argv checks. Shell command strings are rejected.
# SWE_AGENT_VERIFICATION_CHECKS='[{"name":"tests","argv":["python","-m","unittest"],"cwd":".","timeout_seconds":120}]'
