# Copy to .env.local in this implementation checkout; never commit the key.
# Choose an explicit supported provider/model before preparing a trial.
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL=
AGENT_MODEL_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# For anthropic: set provider/model, clear base_url, and fill this key instead.
ANTHROPIC_API_KEY=
# Freeze all three pricing fields using the selected provider's current page.
AGENT_MODEL_INPUT_COST_PER_MILLION_USD=
AGENT_MODEL_OUTPUT_COST_PER_MILLION_USD=
AGENT_MODEL_PRICING_SOURCE=
# Keep external tracing disabled for the first controlled trial.
LANGCHAIN_TRACING_V2=false
